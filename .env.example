# 1. Copy this file and rename it to .env.local.
# 2. Update the environment variables below.

# REQUIRED SETTINGS
# ################# 
# If you are using LiveKit Cloud, the API key and secret can be generated from the Cloud Dashboard.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# URL pointing to the LiveKit server. (example: `wss://my-livekit-project.livekit.cloud`)
LIVEKIT_URL=

# Postgres connection string. On Coolify, create a Postgres service and use its internal connection URL.
DATABASE_URL=
# Set to true only when your Postgres connection requires TLS.
DATABASE_SSL=false

# Host console authentication with Pocket ID.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Pocket ID issuer URL, for example https://id.example.com.
POCKET_ID_ISSUER_URL=
# OIDC client values from Pocket ID.
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=
# Must exactly match the callback URL configured in Pocket ID.
POCKET_ID_REDIRECT_URI=http://localhost:3000/api/host/auth/callback
# Pocket ID group names that can access the host console.
POCKET_ID_ADMIN_GROUP=meet-admins
POCKET_ID_OWNER_GROUP=meet-owners
# Optional: claim containing Pocket ID groups.
POCKET_ID_GROUPS_CLAIM=groups
# Optional: set true only for local HTTP Pocket ID issuers.
# POCKET_ID_ALLOW_INSECURE_HTTP=true


# OPTIONAL SETTINGS
# ################# 
# Recording
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# PUBLIC
# Uncomment settings menu when using a LiveKit Cloud, it'll enable Krisp noise filters.
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record
